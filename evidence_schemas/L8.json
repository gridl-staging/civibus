{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Keel L8 Entity Resolution Regression Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layer",
    "scope",
    "schema_version",
    "produced_at_utc",
    "repo_sha",
    "gate_command",
    "status",
    "regression_pairs_checked",
    "must_match_violations",
    "must_not_match_violations",
    "regression_pair_decided_by_counts",
    "pair_results",
    "false_positive_summary"
  ],
  "properties": {
    "layer": {
      "const": "L8"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "produced_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "repo_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "gate_command": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "error", "waived", "stale", "vacuous"]
    },
    "regression_pairs_checked": {
      "type": "integer",
      "minimum": 0
    },
    "must_match_violations": {
      "type": "integer",
      "minimum": 0
    },
    "must_not_match_violations": {
      "type": "integer",
      "minimum": 0
    },
    "regression_pair_decided_by_counts": {
      "$ref": "#/$defs/decidedByCounts"
    },
    "pair_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "expected_relation",
          "entity_type",
          "entity_id_a",
          "entity_id_b",
          "decision",
          "confidence",
          "decision_method",
          "decided_by",
          "passed"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_relation": {
            "type": "string",
            "enum": ["must_match", "must_not_match"]
          },
          "entity_type": {
            "type": "string",
            "enum": ["person", "organization"]
          },
          "entity_id_a": {
            "type": "string",
            "minLength": 1
          },
          "entity_id_b": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "enum": ["match", "probable_match", "possible_match", "no_match"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "decision_method": {
            "type": "string",
            "minLength": 1
          },
          "decided_by": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "false_positive_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases_evaluated",
        "flagged_false_positives",
        "flagged_case_ids",
        "false_positive_rate",
        "decided_by_counts"
      ],
      "properties": {
        "cases_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "flagged_false_positives": {
          "type": "integer",
          "minimum": 0
        },
        "flagged_case_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "false_positive_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decided_by_counts": {
          "$ref": "#/$defs/decidedByCounts"
        }
      }
    }
  },
  "$defs": {
    "decidedByCounts": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
