{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Keel L5 Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layer",
    "scope",
    "schema_version",
    "produced_at_utc",
    "repo_sha",
    "gate_command",
    "status",
    "total_runs",
    "status_counts"
  ],
  "properties": {
    "layer": {
      "const": "L5"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "produced_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "repo_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "gate_command": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "error", "waived", "stale", "vacuous"]
    },
    "total_runs": {
      "type": "integer",
      "minimum": 0
    },
    "status_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crashed", "empty", "degraded", "success"],
      "properties": {
        "crashed": {
          "type": "integer",
          "minimum": 0
        },
        "empty": {
          "type": "integer",
          "minimum": 0
        },
        "degraded": {
          "type": "integer",
          "minimum": 0
        },
        "success": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
