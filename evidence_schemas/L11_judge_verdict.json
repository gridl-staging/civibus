{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Keel L11 Judge Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layer",
    "scope",
    "verdict",
    "confidence",
    "rubric_version",
    "notes",
    "session_id",
    "timestamp",
    "owner_files",
    "rows"
  ],
  "properties": {
    "layer": {
      "const": "L11"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "uncertain"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rubric_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "owner_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["copy_id", "owner_file", "text"],
        "properties": {
          "copy_id": {
            "type": "string",
            "minLength": 1
          },
          "owner_file": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
