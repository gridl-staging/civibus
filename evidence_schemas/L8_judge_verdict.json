{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layer",
    "scope",
    "verdict",
    "confidence",
    "rubric_version",
    "criteria",
    "notes",
    "session_id",
    "timestamp"
  ],
  "properties": {
    "layer": {
      "const": "L8"
    },
    "scope": {
      "type": "string",
      "const": "er_threshold"
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "uncertain"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rubric_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "criteria": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "reasoning", "evidence_urls"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "false_positive_risk",
              "regression_pair_safety",
              "threshold_delta_safety"
            ]
          },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "uncertain"]
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "evidence_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
