{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layer",
    "scope",
    "schema_version",
    "produced_at_utc",
    "repo_sha",
    "gate_command",
    "status",
    "total_cases",
    "failing_cases",
    "results"
  ],
  "properties": {
    "layer": {
      "const": "L15"
    },
    "scope": {
      "const": "global"
    },
    "schema_version": {
      "const": 1
    },
    "produced_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "repo_sha": {
      "type": "string",
      "minLength": 1
    },
    "gate_command": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "error", "waived", "stale", "vacuous"]
    },
    "total_cases": {
      "type": "integer",
      "minimum": 0
    },
    "failing_cases": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "case_type",
          "route_path",
          "metric_name",
          "normalized_expected",
          "normalized_observed",
          "passed"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "case_type": {
            "type": "string",
            "minLength": 1
          },
          "route_path": {
            "type": "string",
            "minLength": 1
          },
          "metric_name": {
            "type": "string",
            "minLength": 1
          },
          "normalized_expected": {
            "type": "string"
          },
          "normalized_observed": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
