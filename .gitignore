.secret/
.secret*
.env
.env.prod
.DS_Store
__pycache__/
*.pyc
.coverage
htmlcov/
node_modules/
data/
!domains/civics/data/
!domains/civics/data/*.yaml
build/detached_jobs/
*.egg-info/

# The deploy workflow materializes validated promotion evidence here for the
# API build only. The tracked sentinel keeps ordinary builds deterministic.
infra/api/authority_promotion_bundle/*
!infra/api/authority_promotion_bundle/.gitkeep

# Stage 3 browser-capture local profile caches
.tmp/**/profiles/
docs/reference/research/artifacts/2026-03-production-proof/*.dump

.hashbrown

# Auto-generated scrai caches (large, change frequently)
.scrai/codemap_graph_cache.json
.scrai/state.json
.scrai/summaries.json
.scrai/dir_summaries.json

# Large shapefile downloads — too big for git
docs/reference/research/artifacts/*/downloads/**/*.shp
docs/reference/research/artifacts/*/downloads/**/*.zip


.matt/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
/.beads.gate.lock*

# Generated pytest cache (untracked in 0fda5525f, but re-added without this rule)
.pytest_cache/
